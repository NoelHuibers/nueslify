{
  "name": "nueslify",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Your personal AI radio host: news briefings from tagesschau, your Spotify favourites in between.",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.18"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3210 --strictPort --host 127.0.0.1",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "pnpm dlx auth@latest generate --config src/server/auth.ts --output src/server/db/auth-schema.ts",
    "lint:fix": "biome check --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.99",
    "@ai-sdk/openai": "^4.0.96",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "^1.7.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-hotkeys": "^0.14.5",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "@tanstack/react-store": "^0.11.2",
    "@tidal-music/player": "^0.20.1",
    "ai": "^7.0.143",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.58.0",
    "nitro": "3.0.260903-beta",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query-devtools": "^5.104.3",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.3",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
