# Copy to `.env` and fill in what you need. Everything is optional for local development:
# without AI keys the app runs in demo mode (simulated host, silent audio), and free music from
# Audius plays without any credentials.
#
# Older deployments' names are accepted too: TURSO_DATABASE_URL / TURSO_AUTH_TOKEN,
# NEXTAUTH_SECRET, AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION.

# --- Database (libSQL / Turso) ---------------------------------------------------------
# Local file by default. For Turso: libsql://<db>-<org>.turso.io + an auth token.
DATABASE_URL="file:.data/dev.db"
DATABASE_AUTH_TOKEN=""

# --- Better Auth -----------------------------------------------------------------------
# Generate with: openssl rand -base64 32   (required in production, min. 32 chars)
BETTER_AUTH_SECRET=""
# Spotify no longer accepts "localhost" redirect URIs, so use 127.0.0.1 locally.
# On Vercel this defaults to the deployment's URL; set it for a custom domain.
BETTER_AUTH_URL="http://127.0.0.1:3210"

# --- Music sources (all optional) ------------------------------------------------------
# Listeners pick a source in Settings; "Automatic" uses their own connected account first and
# falls back to the free catalogues. See docs/music-providers.md for setup and terms.

# Spotify — https://developer.spotify.com/dashboard
#   Redirect URI: http://127.0.0.1:3210/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# YouTube Music — Google Cloud OAuth client with the YouTube Data API v3 enabled
#   Redirect URI: http://127.0.0.1:3210/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# TIDAL — https://developer.tidal.com
#   Redirect URI: http://127.0.0.1:3210/api/auth/callback/tidal
TIDAL_CLIENT_ID=""
TIDAL_CLIENT_SECRET=""

# Apple Music — MusicKit key from a (paid) Apple Developer Program membership
APPLE_MUSIC_TEAM_ID=""
APPLE_MUSIC_KEY_ID=""
# Contents of the .p8 file; newlines may be written as \n
APPLE_MUSIC_PRIVATE_KEY=""

# Free catalogues (no listener account needed)
# Audius works without any key. Jamendo needs a free client id: https://devportal.jamendo.com
JAMENDO_CLIENT_ID=""
# AUDIUS_APP_NAME="nueslify"
# AUDIUS_DISABLED="true"
# MUSIC_CATALOG="fixture"   # bundled demo tones instead of Audius (tests, offline demos)

# --- AI (optional) ---------------------------------------------------------------------
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
# OPENAI_TEXT_MODEL="gpt-5.4-mini"
# GOOGLE_TEXT_MODEL="gemini-flash-latest"
# OPENAI_TTS_MODEL="gpt-4o-mini-tts"
# Force the offline demo host even when keys are set:
# AI_MOCK="true"

# --- News ------------------------------------------------------------------------------
# No keys needed. "live" fetches tagesschau and the outlets' RSS feeds; "fixture" uses bundled
# offline snapshots (used by the e2e tests). See docs/news-sources.md.
NEWS_SOURCE="live"

# --- Audio storage ---------------------------------------------------------------------
# "local" writes to STORAGE_LOCAL_DIR and serves via /api/audio. "database" keeps audio in the
# database (zero setup; the default on Vercel unless S3_BUCKET is set). "s3" for larger
# deployments (AWS S3, Cloudflare R2, MinIO, ...); it's picked automatically when S3_BUCKET is set.
STORAGE_DRIVER="local"
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL="https://audio.example.com"

# --- Cron ------------------------------------------------------------------------------
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/cron/news. At least 16 characters;
# without it the endpoint stays locked and news is only refreshed when someone listens.
CRON_SECRET=""
